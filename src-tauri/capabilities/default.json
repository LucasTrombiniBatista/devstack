{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões da janela principal: avisos, abrir links no navegador, buscar metadados de páginas e atualizar o app.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "updater:default",
    "process:allow-restart"
  ]
}
