{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevStack",
  "version": "../package.json",
  "identifier": "app.devstack.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevStack",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173 https://www.youtube.com https://vimeo.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Education",
    "shortDescription": "Kanban de estudos local-first",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["pt-BR", "en-US"]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDQUU0Q0MwNzEwRTFFNTIKUldSU0hnNXh3RXl1VEhudXdWaU5mV3dpUHRDb1NENjhRR3JReGR4NXVQK3FoeU5LQ0NkempOMmUK",
      "endpoints": [
        "https://github.com/LucasTrombiniBatista/devstack/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
